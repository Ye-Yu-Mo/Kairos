#!/usr/bin/env bun
// Kairos CLI — AI subjective trading client
// Entry point for global install via `bun link`

const { $ } = await import("bun")
const { resolve } = await import("node:path")

const entry = resolve(import.meta.dirname, "..", "src", "index.ts")
const args = process.argv.slice(2)

await $`bun run --conditions=browser ${entry} ${args}`.nothrow()
