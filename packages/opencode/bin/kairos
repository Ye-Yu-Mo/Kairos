#!/usr/bin/env bun
// Kairos CLI — AI subjective trading client
// Global install: cd packages/opencode && bun link

import { resolve } from "node:path"
import { chdir } from "node:process"

// cd to package root so all dependencies resolve
const pkgDir = resolve(import.meta.dirname, "..")
chdir(pkgDir)

const entry = resolve(pkgDir, "src", "index.ts")
const args = process.argv.slice(2)
const { $ } = await import("bun")
await $`bun run --conditions=browser ${entry} ${args}`.nothrow()
