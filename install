#!/usr/bin/env bash
# Kairos 安装脚本
# 用法: curl -fsSL https://raw.githubusercontent.com/Ye-Yu-Mo/kairos/main/install | bash
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

KAIROS_DIR="${KAIROS_INSTALL_DIR:-$HOME/.kairos}"

echo ""
echo "  █   █    ████    █████   ████      ████    █████"
echo "  █  █    █    █     █     █    █   █    █   █     "
echo "  █ █     █    █     █     █    █   █    █   █     "
echo "  ███     ██████     █     ████     █    █   █████ "
echo "  █ █     █    █     █     █   █    █    █       █ "
echo "  █  █    █    █     █     █    █   █    █       █ "
echo "  █   █   █    █   █████   █    █    ████    █████"
echo ""

if [ -d "$KAIROS_DIR" ]; then
  echo -e "==> ${GREEN}更新 Kairos...${NC}"
  cd "$KAIROS_DIR"
  git pull --ff-only
else
  echo -e "==> ${GREEN}克隆 Kairos 到 $KAIROS_DIR${NC}"
  git clone https://github.com/Ye-Yu-Mo/kairos.git "$KAIROS_DIR"
  cd "$KAIROS_DIR"
fi

echo -e "==> ${GREEN}安装依赖${NC}"
bun install --frozen-lockfile 2>/dev/null || bun install

echo -e "==> ${GREEN}编译 Kairos 插件${NC}"
bun build packages/opencode/plugins/kairos/index.ts --outdir=packages/opencode/plugins/kairos/ --target=bun

echo -e "==> ${GREEN}初始化 .kairos/${NC}"
mkdir -p "$HOME/.kairos-test"
bash kairos-setup.sh 2>/dev/null || true

echo -e "==> ${GREEN}全局注册 kairos 命令${NC}"
cd packages/opencode
bun link --global 2>/dev/null || bun link

echo ""
echo -e "${GREEN}==> 安装完成${NC}"
echo ""
echo "  启动:  kairos"
echo ""
echo "  ⚠️  确保 ~/.bun/bin 在 PATH 中:"
echo "    echo 'export PATH=\"\$HOME/.bun/bin:\$PATH\"' >> ~/.zshrc"
echo "    source ~/.zshrc"
